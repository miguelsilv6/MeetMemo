# Environment Variables Template
# Copy this file to .env and replace the placeholder values

# Hugging Face Token (required for PyAnnote speaker diarization models)
# Get token from: https://huggingface.co/settings/tokens
# Accept model licenses at:
#   - https://huggingface.co/pyannote/speaker-diarization-3.1
#   - https://huggingface.co/pyannote/segmentation-3.0
#   - https://huggingface.co/pyannote/speaker-diarization-community-1  (only if using the 'high' profile)
HF_TOKEN=your_huggingface_token_here

# Hardware Profile (optional) -- easiest way to fit MeetMemo to your machine.
# Bundles hardware-appropriate defaults for the Whisper model, precision, and
# diarization model. Options:
#   auto     - detect GPU VRAM and pick the best profile (DEFAULT)
#   cpu      - no GPU:      whisper=large-v3, int8,          diarization=3.1
#   low      - ~4 GB VRAM:  whisper=turbo,    int8_float16,  diarization=3.1
#   balanced - ~8 GB VRAM:  whisper=large-v3, float16,       diarization=3.1
#   high     - 12 GB+ VRAM: whisper=large-v3, float16,       diarization=community-1
# Profiles favour accuracy over speed: large-v3 on CPU runs at roughly real time
# or slower. Set WHISPER_MODEL_NAME=turbo (or pick it in the admin panel) for speed.
#   custom   - apply no bundled defaults; use only the explicit values below
# Any specific setting below (WHISPER_MODEL_NAME, COMPUTE_TYPE, ...) overrides
# the profile. The active profile is logged at startup and shown at GET /api/v1/system.
# HARDWARE_PROFILE=auto

# Whisper Model Configuration (optional -- overrides the profile)
# Default model for transcription. Options: tiny, base, small, medium, large-v2, large-v3, turbo
# The model chosen in the admin panel, once saved, takes precedence over this.
# WHISPER_MODEL_NAME=turbo

# Diarization Model (optional -- overrides the profile)
# Options: pyannote/speaker-diarization-3.1 (lighter),
#          pyannote/speaker-diarization-community-1 (more accurate, ~12 GB VRAM)
# PYANNOTE_MODEL_NAME=pyannote/speaker-diarization-3.1

# Compute Type for faster-whisper (optional -- overrides the profile)
# Precision for inference. Options: float16 (default), int8, int8_float16
# float16: Best quality, requires GPU (recommended for CUDA)
# int8: Lower memory usage, faster on CPU
# int8_float16: Hybrid mode
# COMPUTE_TYPE=float16

# Device (optional -- overrides the profile and auto-detection)
# Options: cuda:0, cpu. Leave unset to auto-detect.
# DEVICE=cuda:0

# LLM API Configuration (required for AI summarization)
# NOTE: The application automatically appends '/v1/chat/completions' to the URL
# Must use OpenAI-compatible API endpoints
# Example base URLs (do NOT include /v1/chat/completions):
#   - OpenAI: https://api.openai.com
#   - Ollama (v0.1.14+): http://localhost:11434
#   - vLLM: http://localhost:8000
#   - LM Studio: http://localhost:1234
LLM_API_URL=http://localhost:1234
LLM_MODEL_NAME=qwen2.5-14b-instruct
LLM_API_KEY=

# Ask the LLM for a JSON object (response_format) on structured requests such
# as speaker identification. Most OpenAI-compatible servers (incl. vLLM) support
# it. Set to false only if your server rejects the response_format field; the
# response is parsed defensively either way. (optional, default: true)
# LLM_JSON_MODE=true

# Database Configuration
# Generate secure password with: openssl rand -base64 32
POSTGRES_PASSWORD=changeme

# Timezone Configuration (optional)
# Timezone offset in hours for export timestamps
# Examples: +8 for Singapore/GMT+8, -5 for EST, 0 for UTC
TIMEZONE_OFFSET=+8

# GPU Configuration (optional)
# Control which NVIDIA GPUs are visible to the container
# Options: 'all', '0', '0,1', etc.
NVIDIA_VISIBLE_DEVICES=all

# Demo Mode (optional)
# Set to 'true' to skip backend health check (for static deployments like GitHub Pages)
VITE_DEMO_MODE=false

# Port Configuration (optional)
# External ports for nginx reverse proxy
# HTTP_PORT=80
# HTTPS_PORT=443

# Admin Panel (optional)
# Open it from the shield icon in the header (or /#/admin). It tunes the
# transcription settings (model, decoding, anti-hallucination, audio
# preprocessing, default language, retention) without a restart, and keeps an
# audit trail of every change.
# ADMIN_PASSWORD bootstraps the admin account on the FIRST start only (min. 12
# characters); it is stored as a scrypt hash, after which the password is
# changed from the panel and this variable can be removed.
# Without an admin account, the panel stays disabled.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_SESSION_HOURS=8
